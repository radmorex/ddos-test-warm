<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd-агент для macOS (автозапуск load-агента).
     1) mkdir -p /opt/loadswarm && cp agent.py /opt/loadswarm/
     2) python3 -m pip install aiohttp
     3) Впишите адрес контроллера и токен в поля ниже, затем:
        cp scripts/com.loadswarm.agent.plist ~/Library/LaunchAgents/
        launchctl load ~/Library/LaunchAgents/com.loadswarm.agent.plist
     4) Логи: /tmp/loadswarm-agent.log -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.loadswarm.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/opt/loadswarm/agent.py</string>
    <string>--controller</string>
    <string>http://YOUR_CONTROLLER:8080</string>
    <string>--token</string>
    <string>CHANGE_ME</string>
    <string>--name</string>
    <string>mac</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/loadswarm-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/loadswarm-agent.err</string>
</dict>
</plist>
